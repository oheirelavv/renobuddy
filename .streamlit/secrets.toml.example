# Copy this file to secrets.toml and fill in your values.
# Do NOT commit secrets.toml to git.

OPENAI_API_KEY = "your-openai-api-key-here"

[auth]
admin_username = "admin"
admin_password_hash = "salt:sha256hash"
user_username = "user"
user_password_hash = "salt:sha256hash"

# Generate password hashes with:
# python -c "import hashlib, secrets; s=secrets.token_hex(16); print(s+':'+hashlib.sha256((s+'YOUR_PASSWORD').encode()).hexdigest())"
